{
  "rules": {
    ".read": false,
    ".write": false,
    "meta": {
      "ownerUid": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "members": {
      ".read": "auth != null && (root.child('meta/ownerUid').val() === auth.uid)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('meta/ownerUid').val() === auth.uid)",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('role').val() === 'pending') || root.child('meta/ownerUid').val() === auth.uid)",
        "role": {
          ".validate": "newData.isString() && (newData.val().matches(/^(manager|staff|pending|disabled)$/) || (newData.val() === 'owner' && $uid === root.child('meta/ownerUid').val()))"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$base": {
      "meta": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')"
      },
      "settings": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid)"
      },
      "rooms": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()"
        }
      },
      "tenants": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()"
        }
      },
      "invoices": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()",
          ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || (root.child('members').child(auth.uid).child('role').val() === 'staff' && newData.exists()))"
        }
      },
      "payments": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()",
          ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || (root.child('members').child(auth.uid).child('role').val() === 'staff' && newData.exists()))"
        }
      },
      "contracts": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()"
        }
      },
      "archived": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()"
        }
      },
      "incidents": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()"
        }
      },
      "expenses": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()"
        }
      },
      "meterSubs": {
        ".read": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        ".write": "$base.matches(/^phongtro_data(_[A-Za-z0-9]+)?_v2$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager' || root.child('members').child(auth.uid).child('role').val() === 'staff')",
        "$id": {
          ".validate": "newData.hasChild('id') && newData.child('id').val() === $id && newData.child('_u').isNumber()"
        }
      }
    },
    "portal": {
      "$code": {
        ".read": "$code.matches(/^[A-Za-z0-9]{24}$/)",
        ".write": "$code.matches(/^[A-Za-z0-9]{24}$/) && auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
        ".validate": "newData.hasChildren(['v','at'])"
      }
    },
    "portal_in": {
      ".read": "auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
      ".write": "auth != null && (root.child('meta/ownerUid').val() === auth.uid || root.child('members').child(auth.uid).child('role').val() === 'manager')",
      "$code": {
        "$id": {
          ".write": "$code.matches(/^[A-Za-z0-9]{24}$/) && !data.exists() && newData.exists() && root.child('portal').child($code).exists()",
          ".validate": "newData.hasChildren(['type','at']) && newData.child('type').val().matches(/^(incident|meter|join)$/) && newData.child('at').isNumber()",
          "type": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "desc": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "month": {
            ".validate": "newData.isString() && newData.val().length <= 7"
          },
          "elec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "water": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "$other": {
            ".validate": false
          },
          "img": {
            ".validate": "newData.isString() && newData.val().length <= 200000 && newData.val().matches(/^data:image\\/jpeg;base64,/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "cccd": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "dob": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "gender": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "address": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "vehicle": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          }
        }
      }
    }
  }
}