      ".write": "auth != null && (root.child('members').child(auth.uid).child('role').val() === 'owner' || root.child('members').child(auth.uid).child('role').val() === 'manager')",
      "$code": {
        "$id": {
          ".write": "$code.matches(/^[A-Za-z0-9]{24}$/) && !data.exists() && newData.exists() && root.child('portal').child($code).exists()",
          ".validate": "newData.hasChildren(['type','at']) && newData.child('type').val().matches(/^(incident|meter)$/) && newData.child('at').isNumber()",
          "type": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "desc": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "month": {
            ".validate": "newData.isString() && newData.val().length <= 7"
          },
          "elec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "water": {
